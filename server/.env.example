NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Prefer MONGO_URI for new environments. MONGODB_URI is still accepted for existing local setups.
MONGO_URI=mongodb://127.0.0.1:27017/library-management-system
JWT_SECRET=replace-with-a-strong-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

SMTP_HOST=smtp-relay.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-pass
EMAIL_FROM=Library Management <noreply@example.com>

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
